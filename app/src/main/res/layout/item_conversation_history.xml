<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_assistant_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/history_session_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#172033"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/history_session_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#687386"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/history_session_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#4D86E8"
        android:textSize="12sp" />
</LinearLayout>
