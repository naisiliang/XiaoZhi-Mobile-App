<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_assistant_card"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/message_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="文件结果"
            android:textColor="#2864C7"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/message_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#263246"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/artifact_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#687386"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/artifact_open"
                    style="@style/ArtifactCardAction"
                    android:text="打开" />

                <TextView
                    android:id="@+id/artifact_save"
                    style="@style/ArtifactCardAction"
                    android:layout_marginStart="4dp"
                    android:text="保存" />

                <TextView
                    android:id="@+id/artifact_share"
                    style="@style/ArtifactCardAction"
                    android:layout_marginStart="4dp"
                    android:text="分享" />

                <TextView
                    android:id="@+id/artifact_edit"
                    style="@style/ArtifactCardAction"
                    android:layout_marginStart="4dp"
                    android:text="编辑" />

                <TextView
                    android:id="@+id/artifact_regenerate"
                    style="@style/ArtifactCardAction"
                    android:layout_marginStart="4dp"
                    android:text="再生成" />

                <TextView
                    android:id="@+id/artifact_restore"
                    style="@style/ArtifactCardAction"
                    android:layout_marginStart="4dp"
                    android:text="恢复" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
