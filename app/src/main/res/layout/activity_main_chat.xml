<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/chat_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/home_navigation"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="打开会话菜单"
            android:gravity="center"
            android:text="☰"
            android:textColor="#172033"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/assistant_avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_assistant_avatar"
            android:gravity="center"
            android:text="小白"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/assistant_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="小白智能体"
                android:textColor="#172033"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/assistant_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#687386"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="更多选项"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#526078"
            android:textSize="28sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/conversation_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp" />

    <HorizontalScrollView
        android:id="@+id/quick_actions_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:fadeScrollbars="false"
        android:overScrollMode="never"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/quick_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quick_open_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_quick_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="9dp"
                android:text="智能思考"
                android:textColor="#2864C7"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/quick_nearby"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_quick_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="9dp"
                android:text="打给小白"
                android:textColor="#2864C7"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/quick_music"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_quick_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="9dp"
                android:text="AI写作"
                android:textColor="#2864C7"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/quick_volume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_quick_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="9dp"
                android:text="总结"
                android:textColor="#2864C7"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/composer_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_composer"
        android:gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/composer_avatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_assistant_avatar"
            android:gravity="center"
            android:text="白"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="top|start"
            android:hint="点击输入或按住说话"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="44dp"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:textColor="#172033"
            android:textColorHint="#9AA4B5"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/send_message"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:clickable="true"
            android:contentDescription="发送消息"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_composer_action"
            android:text="＋"
            android:textColor="#2864C7"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
